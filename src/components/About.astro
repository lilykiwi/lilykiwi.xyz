---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';

// everything shown here lives in src/content/about/about.md
const about = await getEntry('about', 'about');
if (!about) throw new Error('src/content/about/about.md is missing');

const { github, specs, people, peopleTitle } = about.data;
const { Content } = await render(about);
---

<div class="about">
  <div class="aboutIntro">
    <div class="aboutBio">
      <Content />
    </div>
    <!-- pulled live from github, so it follows the profile picture there -->
    <img
      class="avatar"
      src={`https://github.com/${github}.png?size=256`}
      alt={`${github}'s profile picture`}
      width="128"
      height="128"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="specs">
    {
      specs.map(({ title, rows }, i) => (
        <section class="specCard" style={`--i: ${Math.min(i, 12)}`}>
          <h3 class="specTitle">{title}</h3>
          <dl>
            {Object.entries(rows).map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </section>
      ))
    }
  </div>

  {
    people.length > 0 && (
      <section class="people">
        <h3 class="specTitle">{peopleTitle}</h3>
        <ul class="peopleList">
          {people.map(({ name, url, image }, i) => (
            <li>
              <a class="person" href={url} rel="noopener" style={`--i: ${Math.min(i, 12)}`}>
                {typeof image === 'string' ? (
                  /* hosted by the person, so it follows whatever they change it to; no referrer, so their site doesn't learn which page loaded it */
                  <img
                    class="personAvatar"
                    src={image}
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                ) : image ? (
                  <Image class="personAvatar" src={image} alt="" width={144} height={144} format="webp" />
                ) : (
                  <span class="personAvatar personInitial" aria-hidden="true">
                    {name.charAt(0)}
                  </span>
                )}
                <span class="personName">{name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
