---
import { ArrowLeftIcon, ArrowRightIcon } from './icons';

interface Props {
  href: string;
  label: string;
  /** back links lead with an arrow, forward links end with one and sit on the right */
  direction?: 'back' | 'forward';
}

const { href, label, direction = 'back' } = Astro.props;
---

<div class:list={['linkRow', 'pageLinkRow', direction === 'forward' && 'forward']}>
  <a href={href}>
    {direction === 'back' && <ArrowLeftIcon />}
    {label}
    {direction === 'forward' && <ArrowRightIcon />}
  </a>
</div>
