---
import '../style.css';
import { ClientRouter } from 'astro:transitions';
import { Shell } from '../components/Shell';
import type { BackLink, SidebarItem } from '../components/sidebar';

interface Props {
  title: string;
  description?: string;
  /** show the large hero above the nav strip (home only) */
  hero?: boolean;
  /** sections for the floating menu and scrollspy; leave empty for pages that don't need one */
  sections?: SidebarItem[];
  /** link to the parent page, shown where the hamburger would be on pages without sections */
  back?: BackLink;
}

const { title, description = 'lilykiwi.xyz', hero = false, sections = [], back } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <style>
      html {
        background-color: #18191b;
      }
    </style>
    <!-- fonts are linked here rather than @imported from the stylesheet: the router keeps identical head elements
         across navigations, whereas an @import inside a swapped <style> is fetched again and the text flashes in fallback fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@300&family=REM:wght@300&display=swap"
    />
    <!-- the title picture is what the page needs first, so start fetching it now instead of when the markup reaches it
         (the type attribute makes browsers without AVIF skip this and use the WebP the <picture> falls back to) -->
    {
      hero ? (
        <link rel="preload" as="image" href="/title-hero.avif" type="image/avif" fetchpriority="high" />
      ) : (
        <link rel="preload" as="image" href="/title-brand.avif" type="image/avif" />
      )
    }
    <!-- A reload or back/forward lands on a restored scroll position, so the cards' entrance animation is skipped
         (data-restored, see style.css): playing it there makes already-placed content slide in. The router replaces
         the root's attributes on each navigation, so clicking a link plays it as usual. -->
    <script is:inline>
      {
        const nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type !== 'navigate') document.documentElement.dataset.restored = '';
      }
    </script>
    <!-- same-document view transitions (document.startViewTransition), so no cross-document @view-transition rule is needed -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Shell client:load path={path} hero={hero} sections={sections} back={back}>
      <slot />
    </Shell>
    <!-- The sticky header is pulled up by the hero's height (--hero-h) so only the strip stays pinned, but the Shell only
         sets that once it has hydrated; until then the whole hero would sit pinned over the page. Setting it here, while
         the markup is parsed, means it is right from the first paint (the Shell keeps it up to date afterwards).
         data-astro-rerun: the router only re-runs inline scripts that ask for it. -->
    <script is:inline data-astro-rerun>
      {
        const header = document.querySelector('.siteHeader');
        const hero = header && header.querySelector('.hero');
        if (hero) header.style.setProperty('--hero-h', hero.offsetHeight + 'px');
      }
    </script>
    <!-- Astro turns the browser's own scroll restoration off and restores the position itself, but only once its script
         has loaded, so a reload would first paint at the top and then jump down. The position it saved is in
         history.state, and the markup above is complete by now, so restore it here, before the first paint (Astro's own
         restore later lands on the same spot). Only for a reload or back/forward into this document, and not re-run on
         router navigations, which handle their own scrolling. -->
    <script is:inline>
      {
        const nav = performance.getEntriesByType('navigation')[0];
        const state = history.state;
        // instant: the page's scroll-behavior is smooth, which would animate this from the top
        if (nav && nav.type !== 'navigate' && state && state.scrollY) {
          scrollTo({ left: state.scrollX || 0, top: state.scrollY, behavior: 'instant' });
        }
      }
    </script>
    <script>
      // Grows or shrinks the header when a navigation adds or removes the hero. This animates the real element
      // (not the view transition's snapshots, which Gecko and Blink size differently), so every engine matches.
      // Runs once: the router keeps module scripts alive across navigations.
      const DURATION = 400;
      const EASING = 'cubic-bezier(0.4, 0, 0.2, 1)';
      const header = () => document.querySelector<HTMLElement>('.siteHeader');

      // The router only treats a link to the current page as a no-op when it has a #hash; a plain one would fetch the
      // identical page and swap it in, remounting every island (the repo list refetches from GitHub, etc.). Claim those
      // clicks first (capture phase; the router skips default-prevented ones) and just scroll back to the top.
      document.addEventListener(
        'click',
        (ev) => {
          if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
          const link = (ev.target as Element).closest<HTMLAnchorElement>('a[href]');
          if (!link || (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
          const to = new URL(link.href, location.href);
          if (to.origin !== location.origin || to.pathname !== location.pathname || to.search !== location.search || to.hash) return;
          ev.preventDefault();
          // drop a leftover #section from the address, keeping the router's own history state
          if (location.hash) history.replaceState(history.state, '', to.pathname + to.search);
          window.scrollTo({ top: 0 });
        },
        true,
      );

      // where the header's bottom edge is on screen (a pinned strip counts as just the strip), and the page body to fade
      let from = 0;
      // back/forward restores a scroll position, and resizing the header underneath that makes it land short, so those skip the morph
      let traversing = false;
      document.addEventListener('astro:before-swap', (ev) => {
        from = header()?.getBoundingClientRect().bottom ?? 0;
        traversing = ev.navigationType === 'traverse';
      });

      // the new page is in place and scrolled to the top, still inside the transition's update callback
      document.addEventListener('astro:after-swap', () => {
        if (traversing || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const el = header();
        if (!el) return;
        const to = el.offsetHeight;
        if (Math.abs(to - from) < 1) return;

        el.dataset.morph = '';
        // the shell reads scroll position to decide stuck/titleGone and pauses while morphing, so prod it once layout is real again
        const done = () => {
          delete el.dataset.morph;
          window.dispatchEvent(new Event('scroll'));
        };
        el.animate({ height: [`${from}px`, `${to}px`] }, { duration: DURATION, easing: EASING }).finished.then(done, done);
        document
          .querySelector<HTMLElement>('.content')
          ?.animate({ opacity: [0, 1] }, { duration: DURATION, easing: EASING });
      });
    </script>
  </body>
</html>
