---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { count, getAlbums, getPhotos } from '../../lib/albums';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: album.id }, props: { album } }));
}

const { album } = Astro.props;
const photos = getPhotos(album);

// full-size versions the thumbnails link to, with the long edge capped (not the width, which would make portraits much larger than landscapes)
const LONG_EDGE = 3000;
const full = await Promise.all(
  photos.map(({ image }) => {
    const width = image.width >= image.height ? LONG_EDGE : Math.round((LONG_EDGE * image.width) / image.height);
    return getImage({ src: image, width, format: 'webp' });
  }),
);

const format = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${album.data.title} · lilykiwi.xyz`} description={album.data.description} back={{ href: '/gallery/', label: 'gallery', icon: 'image' }}>
  <header class="albumHeader">
    <h1 class="sectionHeading">{album.data.title}</h1>
    <p class="postMeta">{format(album.data.date)} · {count(photos.length)}</p>
    {album.data.description && <p>{album.data.description}</p>}
  </header>

  <ul class="photoGrid">
    {
      photos.map((photo, i) => (
        <li style={`--i: ${Math.min(i, 12)}`}>
          <a href={full[i].src} title={photo.caption}>
            <Image src={photo.image} alt={photo.alt} width={1100} format="webp" loading="lazy" />
          </a>
          {photo.caption && <p class="caption">{photo.caption}</p>}
        </li>
      ))
    }
  </ul>
  <!-- The grid is CSS columns, so the markup order runs down the left column and then the right one, which would
       stagger the entrance column by column. This re-indexes the photos by where they sit (first of each column, then the
       second of each, left to right) so the entrance reads row by row. Runs before first paint; without it, the
       server-rendered markup order is the fallback. The router only re-runs inline scripts marked data-astro-rerun. -->
  <script is:inline data-astro-rerun>
    (() => {
      const grid = document.querySelector('.photoGrid');
      if (!grid) return;
      const place = () => {
        const items = [...grid.children];
        const left = (li) => Math.round(li.getBoundingClientRect().left);
        const cols = [...new Set(items.map(left))].sort((a, b) => a - b);
        const rank = cols.map(() => 0);
        for (const li of items) {
          const c = cols.indexOf(left(li));
          li.style.setProperty('--i', Math.min(rank[c]++ * cols.length + c, 12));
        }
      };
      place();
      // the column count follows the width; tied to the grid so it goes away with the page
      new ResizeObserver(place).observe(grid);
    })();
  </script>
</Base>
