---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import AlbumGrid from '../components/AlbumGrid.astro';
import { Repositories } from '../components/repos';
import type { SidebarItem } from '../components/sidebar';
import { getPosts } from '../lib/posts';
import { getAlbums } from '../lib/albums';

const sections: SidebarItem[] = [
  { id: 'about', label: 'about', icon: 'person' },
  { id: 'projects', label: 'projects', icon: 'repo' },
  { id: 'blog', label: 'blog', icon: 'book' },
  { id: 'gallery', label: 'gallery', icon: 'image' },
];

// the latest few of each; the full lists live on /blog/ and /gallery/
const posts = await getPosts();
const albums = await getAlbums();
const POSTS_SHOWN = 5;
const ALBUMS_SHOWN = 6;
---

<Base title="lilykiwi.xyz" hero sections={sections}>
  <link slot="head" rel="preload" as="fetch" href="https://api.github.com/users/lilykiwi/repos" crossorigin />

  <section id="about" class="section">
    <h2 class="sectionHeading">about</h2>
    <!-- placeholder until there is something to say -->
    <p class="placeholder">nothing here yet.</p>
  </section>

  <section id="projects" class="section">
    <h2 class="sectionHeading">projects</h2>
    <Repositories client:load />
  </section>

  <section id="blog" class="section">
    <h2 class="sectionHeading">blog</h2>
    <PostList posts={posts.slice(0, POSTS_SHOWN)} />
    {posts.length > POSTS_SHOWN && <p class="moreLink"><a href="/blog/">all posts →</a></p>}
  </section>

  <section id="gallery" class="section">
    <h2 class="sectionHeading">gallery</h2>
    <AlbumGrid albums={albums.slice(0, ALBUMS_SHOWN)} />
    {albums.length > ALBUMS_SHOWN && <p class="moreLink"><a href="/gallery/">all albums →</a></p>}
  </section>
</Base>
