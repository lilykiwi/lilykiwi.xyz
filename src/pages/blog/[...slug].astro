---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const format = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${post.data.title} · lilykiwi.xyz`} description={post.data.description}>
  <article class="prose">
    <header>
      <h1>{post.data.title}</h1>
      <p class="postMeta">
        <time datetime={post.data.date.toISOString()}>{format(post.data.date)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
      </p>
    </header>
    <Content />
  </article>
</Base>
