---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const format = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="blog · lilykiwi.xyz" description="Posts from lilykiwi.xyz">
  <h1 class="sectionHeading">blog</h1>

  {
    posts.length === 0 ? (
      <p class="placeholder">no posts yet.</p>
    ) : (
      <ul class="postList">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="postTitle">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>{format(post.data.date)}</time>
              {post.data.description && <span class="postSummary">{post.data.description}</span>}
              {post.data.draft && <span class="badge">draft</span>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
