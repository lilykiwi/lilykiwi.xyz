{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  "typedocOptions": {
    "entryPoints": ["src/index.tsx"],
    "out": "docs",
    "gitRemote": "lilykiwi.xyz",
    "githubPages": false,
    "readme": "none"
  }
}
